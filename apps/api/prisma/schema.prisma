// Prisma schema for Web3 Freelance Platform Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  FREELANCER
  JUROR
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  FREELANCER_SELECTED
  OPEN
  IN_PROGRESS
  COMPLETED
  DISPUTED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  VERIFYING
  APPROVED
  RELEASED
  DISPUTED
  PROCESSING_AUTORELEASE
}

enum DisputeStatus {
  OPEN
  VOTING
  RESOLVED
}

enum VoteChoice {
  FREELANCER_FAVOR
  CLIENT_FAVOR
}

model User {
  id                String           @id @default(uuid())
  email             String?          @unique
  passwordHash      String?
  walletAddress     String?          @unique
  siweNonce         String?
  role              Role             @default(FREELANCER)
  name              String?
  bio               String?
  location          String?
  rating            Float            @default(5.0)
  portfolioLinks    String[]         @default([])
  isPro             Boolean          @default(false)
  jobsPostedCount   Int              @default(0)
  jobsAppliedCount  Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  postedJobs        Job[]            @relation("ClientJobs")
  assignedJobs      Job[]            @relation("FreelancerJobs")
  applications      JobApplication[] @relation("FreelancerApplications")
  initiatedDisputes Dispute[]        @relation("InitiatedDisputes")
}

model Job {
  id             String           @id @default(uuid())
  title          String
  description    String
  budget         Float
  tokenSymbol    String           @default("ETH")
  skills         String[]         @default([])
  deadline       DateTime?
  escrowAddress  String?
  status         JobStatus        @default(DRAFT)

  clientId       String
  client         User             @relation("ClientJobs", fields: [clientId], references: [id])

  freelancerId   String?
  freelancer     User?            @relation("FreelancerJobs", fields: [freelancerId], references: [id])

  milestones     Milestone[]
  applications   JobApplication[]
  disputes       Dispute[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Milestone {
  id              String          @id @default(uuid())
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title           String
  description     String
  amount          Float
  deadline        DateTime?
  deliverableLink String?
  githubPrUrl     String?
  deploymentUrl   String?
  aiReviewScore   Float?
  status          MilestoneStatus @default(PENDING)
  submittedAt     DateTime?

  disputes        Dispute[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model JobApplication {
  id            String            @id @default(uuid())
  jobId         String
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId  String
  freelancer    User              @relation("FreelancerApplications", fields: [freelancerId], references: [id])

  pitch         String
  requestedRate Float
  deliveryDays  Int?              @default(7)
  walletAddress String?
  status        ApplicationStatus @default(SUBMITTED)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([jobId, freelancerId])
}

model Dispute {
  id           String        @id @default(uuid())
  jobId        String
  job          Job           @relation(fields: [jobId], references: [id])
  milestoneId  String
  milestone    Milestone     @relation(fields: [milestoneId], references: [id])
  initiatorId  String
  initiator    User          @relation("InitiatedDisputes", fields: [initiatorId], references: [id])

  reason       String
  evidenceUrls String[]      @default([])
  status       DisputeStatus @default(OPEN)

  votes        JurorVote[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model JurorVote {
  id            String     @id @default(uuid())
  disputeId     String
  dispute       Dispute    @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  jurorAddress  String
  vote          VoteChoice
  rewardClaimed Boolean    @default(false)
  createdAt     DateTime   @default(now())
}

model Admin {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique
  password   String
  name       String
  seatNumber Int?      @default(1) @map("seat_number")
  title      String?   @default("Platform Arbitrator")
  role       String?   @default("ADMIN")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admins")
}